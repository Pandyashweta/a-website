datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum SubscriberStatus {
  UNVERIFIED
  SUBSCRIBED
  UNSUBSCRIBED
  BOUNCED
}

enum NewsletterStatus {
  DRAFT
  SCHEDULED
  SENT
  ARCHIVED
}

enum AnalyticsType {
  OPEN
  CLICK
  BOUNCE
  UNSUBSCRIBE
}

model Admin {
  id               String   @id @default(cuid())
  email            String   @unique
  passwordHash     String
  name             String?
  role             String   @default("ADMIN")
  twoFactorEnabled Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Subscriber {
  id               String           @id @default(cuid())
  email            String           @unique
  firstName        String?
  status           SubscriberStatus @default(UNVERIFIED)
  verificationToken String?         @unique
  verifiedAt       DateTime?
  unsubscribeToken String           @unique @default(cuid())
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  tags             SubscriberTag[]
  analytics        Analytics[]
  timelines        SubscriberTimeline[]
}

model Tag {
  id          String          @id @default(cuid())
  name        String          @unique
  createdAt   DateTime        @default(now())
  subscribers SubscriberTag[]
}

model SubscriberTag {
  subscriberId String
  tagId        String

  subscriber   Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  tag          Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([subscriberId, tagId])
}

model SubscriberTimeline {
  id           String     @id @default(cuid())
  subscriberId String
  event        String
  description  String?
  createdAt    DateTime   @default(now())

  subscriber   Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
}

model Newsletter {
  id              String           @id @default(cuid())
  title           String
  slug            String           @unique
  contentMarkdown String
  contentHtml     String
  status          NewsletterStatus @default(DRAFT)
  scheduledAt     DateTime?
  sentAt          DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  campaigns       Campaign[]
}

model Campaign {
  id               String      @id @default(cuid())
  newsletterId     String
  sentCount        Int         @default(0)
  openCount        Int         @default(0)
  clickCount       Int         @default(0)
  bounceCount      Int         @default(0)
  unsubscribeCount Int         @default(0)
  createdAt        DateTime    @default(now())

  newsletter       Newsletter  @relation(fields: [newsletterId], references: [id], onDelete: Cascade)
  analytics        Analytics[]
}

model Analytics {
  id           String        @id @default(cuid())
  type         AnalyticsType
  subscriberId String?
  campaignId   String?
  url          String?
  country      String?
  device       String?
  browser      String?
  ipAddress    String?
  createdAt    DateTime      @default(now())

  subscriber   Subscriber?   @relation(fields: [subscriberId], references: [id], onDelete: SetNull)
  campaign     Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
}

model ApiKey {
  id          String    @id @default(cuid())
  key         String    @unique
  name        String
  permissions String    @default("READ_WRITE")
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
}
